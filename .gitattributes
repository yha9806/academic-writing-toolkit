# Force LF line endings on all text files. Defends against CRLF noise from
# Windows users who clone via Git Bash / WSL without `core.autocrlf=input`.
# Binary files are auto-detected and left alone by `text=auto`.
* text=auto eol=lf

# Mark all bash scripts and the python helper as text explicitly,
# in case `text=auto` misclassifies them.
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
Makefile text eol=lf

# Frozen experiment packets carry byte-level hashes. Preserve producer bytes
# across platforms rather than applying the repository's text conversion.
e1/published/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve imported long-document measurements and source provenance.
workbench/final_output/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
workbench/INTEGRATION.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
