{
  "name": "@awt/guards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWT deterministic guards as an installable dsh bundle: chapter-write/page-budget enforcement, session-log projections, escalation ask-gate.",
  "main": "./dist/dsh-plugin.js",
  "exports": {
    ".": "./dist/dsh-plugin.js",
    "./notes-lint": "./dist/notes-lint.js",
    "./vocabulary": "./dist/vocabulary.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.12 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "lint:notes": "node --import tsx src/notes-lint.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.6 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
